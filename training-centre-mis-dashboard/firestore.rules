rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAnudipOrAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (
          request.auth.token.email == 'ravinamdev998@gmail.com' ||
          request.auth.token.email.matches('(?i).*@anudip\\.org$') ||
          request.auth.token.email.matches('.*@anudip[.]org$')
        );
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (
          request.auth.token.email == 'ravinamdev998@gmail.com' ||
          request.auth.token.email.matches('(?i).*@anudip\\.org$') ||
          request.auth.token.email.matches('.*@anudip[.]org$')
        );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Connection test probe
    match /test/connection {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Admin registry
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // Central Dataset Metadata
    match /mis_dataset/{datasetId} {
      allow get, list: if isAnudipOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Central Dataset Chunks
    match /mis_dataset_chunks/{chunkId} {
      allow get, list: if isAnudipOrAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
